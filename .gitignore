# Python
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Секреты
.env
.env.*
!.env.example

# БД и кэш (персистентный том)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/cache/*
!data/cache/.gitkeep

# Образцы источников: не коммитим, скачиваются заново.
# URL — в tests/conftest.py; тесты без файлов скипаются (pytest.mark.skipif).
data/sample_schedule.docx
data/sample_substitutions.html

# Резервные копии БД (создаются автоматически рядом с bot.db)
data/backups/

# VK-бот (vkbottle Long Poll): состояние long-poll (ts) пишется в .vkbottle/
.vkbottle/

# IDE
.idea/
.vscode/

# Временные диагностические скрипты (создаются под задачи, не коммитим)
_diag*.py

# Mini App (Next.js): исходники коммитим, сборку — нет.
# out/ собирается внутри Docker на стадии frontend и в git не нужен.
webapp/node_modules/
webapp/.next/
webapp/out/

# Секреты и локальные настройки фронта: в dev API живёт на localhost:8080.
# Шаблон — webapp/.env.example (коммитим).
webapp/.env*.local
