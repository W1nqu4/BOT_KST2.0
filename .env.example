# Шаблон конфигурации (коммитится). Скопируйте в .env и заполните:
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# ВНИМАНИЕ: .env с реальными значениями никогда не коммитить — он в .gitignore.

# === Секреты ===
# Токен от @BotFather (обязательно)
BOT_TOKEN=
# tg_id администраторов через запятую.
# Создатель: @W1nqu4 (908084777)
ADMIN_IDS=908084777
# Чат для алертов (обычно = твой tg_id). Необязательно.
ADMIN_CHAT_ID=

# === Настройки ===
# Публичный HTTPS-URL для .ics-ссылок (обязательно).
# Локально: http://localhost:8080, на Amvera: https://<имя>.amvera.io
PUBLIC_BASE_URL=
# Порт aiohttp-сервера (8080; Amvera передаёт PORT автоматически)
PORT=
# Путь к SQLite (./data/bot.db; в контейнере — /app/data/bot.db)
DB_PATH=
# Каталог кэша источников (data/cache; в контейнере — /app/data/cache)
CACHE_DIR=
# Уровень логирования: DEBUG | INFO | WARNING | ERROR (INFO)
LOG_LEVEL=

# === VK-бот (Long Poll API) ===
# Токен сообщества: Управление → Настройки → Работа с API → Ключи доступа.
# Права: сообщения сообщества + управление сообществом.
VK_TOKEN=
# Числовой ID сообщества (без минуса и без префикса club).
VK_GROUP_ID=